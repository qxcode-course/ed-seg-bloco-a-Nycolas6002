            "content": "package main\nimport \"fmt\"\n\nfunc fibonnaci(n,k int) int{\n\n    if(n == 1){\n        return 1\n    }\n\n    if(n == 2){\n        return 1\n    }\n\n    resultado := fibonnaci(n-1,k) + k  * fibonnaci(n-2,k) \n\n    return resultado\n}\n\nfunc main() {\n    var n, k int\n    fmt.Scan(&n,&k)\n    fmt.Println(fibonnaci(n,k))\n}\n",
