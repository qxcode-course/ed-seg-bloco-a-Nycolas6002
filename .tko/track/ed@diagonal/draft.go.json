            "content": "package main\nimport (\n    \"fmt\"\n    \"strings\"\n)\n\n\nfunc diagonal(s string, k int){\n    if len(s) == 0 {\n        return\n    }\n    // jefferson 9\n\n    // Println\n    fmt.Println(string(s[0]))\n    diagonal(s[1:],k-1)\n    fmt.Print(strings.Repeat(\" \", k))\n\n}\n\nfunc main() {\n    var palavra string\n    fmt.Scan(&palavra)\n    qtdCaracteres := len(palavra)\n    // fmt.Println(diagonal(palavra, qtdCaracteres))\n    diagonal(palavra, qtdCaracteres)\n}\n",
